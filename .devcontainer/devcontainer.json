{
    "build": {
        "dockerfile": "Dockerfile"
    },
    "runArgs": [
        "--gpus=all" // or remove if not using GPUs
    ],
    "containerEnv": {
        "WAYLAND_DISPLAY": ""
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cmake-tools"
            ]
        }
    }
}
